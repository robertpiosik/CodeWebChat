{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es6",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "declaration": true,
    "types": ["node", "jest"],
    "sourceMap": true,
    "paths": {
      "@shared/*": ["../shared/src/*"],
      "@ui/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../shared/src/*.ts",
    "../shared/src/*.tsx"
  ]
}

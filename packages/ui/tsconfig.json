{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "declaration": true,
    "types": ["node"],
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*", "../../apps/editor/src/*"],
      "@shared/*": ["../shared/src/*"],
      "@ui/*": ["./src/*"]
    },
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../shared/src/*.ts",
    "../shared/src/*.tsx",
    "../../apps/editor/src/**/*.ts",
    "../../apps/editor/src/**/*.tsx",
    "../../apps/editor/src/views/settings/helpers/open-settings.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ESNext",
    "outDir": "out",
    "lib": ["ESNext", "dom"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "rootDir": "../../",
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "@shared/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

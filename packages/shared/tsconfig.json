{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ESNext",
    "lib": ["ESNext", "dom"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@shared/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../ui/src/**/*.ts",
    "../ui/src/**/*.tsx",
    "../../apps/editor/src/**/*.ts",
    "../../apps/editor/src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}

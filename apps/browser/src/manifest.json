{
  "manifest_version": 3,
  "author": "Robert Piosik",
  "name": "Autofill for Code Web Chat",
  "short_name": "CWC",
  "description": "Autofill CWC-constructed markdown prompts in free chatbots.",
  "version": "2026.1031.28",
  "homepage_url": "https://github.com/robertpiosik/CodeWebChat",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms"],
  "action": {
    "default_title": "Autofill for Code Web Chat",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://copilot.com/chat",
        "https://chat.deepseek.com/",
        "https://www.doubao.com/chat/",
        "https://gemini.google.com/*",
        "https://github.com/copilot/*",
        "https://grok.com/*",
        "https://huggingface.co/chat/",
        "https://arena.ai/*",
        "https://www.kimi.ai/",
        "https://www.kimi.com/",
        "https://www.meta.ai/",
        "https://chat.mistral.ai/work*",
        "http://openwebui/",
        "https://openrouter.ai/chat*",
        "https://chat.qwen.ai/*",
        "https://chat.together.ai/",
        "https://yuanbao.tencent.com/*",
        "https://chat.z.ai/",
        "https://zchat.z.ai/"
      ],
      "js": ["send-prompt-content-script.js"]
    }
  ]
}

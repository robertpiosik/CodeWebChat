{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "ESNext"],
    "module": "ESNext",
    "noEmit": true,
    "rootDir": "../..",
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["chrome", "webextension-polyfill", "node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../packages/shared/src/*"],
      "@ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/src/**/*",
    "../../packages/ui/src/**/*"
  ]
}

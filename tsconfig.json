{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["jest", "chrome"],
    "rootDir": ".",
    "paths": {
      "@/*": [
        "./apps/editor/src/*",
        "./apps/browser/src/*",
        "./apps/web/src/*",
        "./packages/ui/src/*"
      ],
      "@shared/*": ["./packages/shared/src/*"],
      "@ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
